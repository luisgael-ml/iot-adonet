    {
      "id": 8,
      "type": "table",
      "title": "Sensores y ultima lectura",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "iot-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "iot-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.codigo AS sensor, s.tipo, s.umbral_max AS umbral, u.valor AS \"ultimo valor\", to_char(u.medido_en, 'HH24:MI:SS') AS hora\nFROM sensores s LEFT JOIN LATERAL (SELECT valor, medido_en FROM lecturas l WHERE l.sensor_id = s.id ORDER BY medido_en DESC LIMIT 1) u ON TRUE\nORDER BY s.codigo"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Alertas recientes",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "iot-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "iot-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(a.creada_en, 'HH24:MI:SS') AS hora, s.codigo AS sensor, a.severidad, a.valor, a.umbral,\n       CASE WHEN a.atendida THEN 'si' ELSE 'no' END AS atendida\nFROM alertas a JOIN sensores s ON s.id = a.sensor_id ORDER BY a.id DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severidad"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "INSERT": {
                        "color": "green",
                        "index": 0
                      },
                      "UPDATE": {
                        "color": "blue",
                        "index": 1
                      },
                      "DELETE": {
                        "color": "red",
                        "index": 2
                      },
                      "web-csharp": {
                        "color": "purple",
                        "index": 3
                      },
                      "reporte-vb": {
                        "color": "orange",
                        "index": 4
                      },
                      "critica": {
                        "color": "red",
                        "index": 5
                      },
                      "advertencia": {
                        "color": "orange",
                        "index": 6
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      }
    },
