    {
      "id": 5,
      "type": "timeseries",
      "title": "Temperatura por minuto",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "iot-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "iot-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('minute', l.medido_en) AS time, s.codigo AS metric, ROUND(AVG(l.valor), 2) AS value\nFROM lecturas l JOIN sensores s ON s.id = l.sensor_id\nWHERE s.tipo = 'temperatura' AND $__timeFilter(l.medido_en)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
