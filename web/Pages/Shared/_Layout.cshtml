<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · IoT Analytics Dashboard</title>
    <link rel="stylesheet" href="~/estilos.css" />
</head>
<body>
    <header>
        <div class="contenedor barra">
            <div class="marca">IoT Analytics Dashboard <span>· Cliente ADO.NET (C#)</span></div>
            <nav>
                <a asp-page="/Index">Sensores</a>
                <a asp-page="/Dispositivos">Dispositivos</a>
                <a asp-page="/Alertas">Alertas</a>
                <a asp-page="/Rendimiento">Rendimiento</a>
            </nav>
        </div>
    </header>
    <main class="contenedor">
        @if (TempData["Ok"] is string ok)
        {
            <div class="aviso ok">@ok</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="aviso error">@error</div>
        }
        @RenderBody()
    </main>
    <footer class="contenedor">NexoDev Solutions · PostgreSQL 16 + Npgsql (ADO.NET) · Luis Gael Monterrubio López</footer>
</body>
</html>
